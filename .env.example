ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.com
# Optional — overrides the auto-derived accounts host (e.g. accounts.zoho.com.cn).
# ZOHO_ACCOUNTS_DOMAIN=accounts.zoho.com
ZOHO_ACCOUNT=jeramoda
ZOHO_APP=eom
# Optional — Zoho Creator API version. Defaults to v2.1; set v2 to test legacy.
# ZOHO_API_VERSION=v2.1

# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Base URL baked into every generated QR / Excel label.
# If set, QR codes point here; if unset, the app falls back to window.location.origin.
# Must be prefixed VITE_ to be exposed to the browser build.
VITE_APP_BASE_URL=https://scan.jera-iku.top
